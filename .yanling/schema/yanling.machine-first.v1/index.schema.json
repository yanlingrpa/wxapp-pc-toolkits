{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "yanling.machine-first/v1 index.json",
  "type": "object",
  "required": ["schema_version", "generated_at", "module", "files", "packages", "topics", "symbols"],
  "properties": {
    "schema_version": {
      "const": "yanling.machine-first/v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "module": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "object",
      "required": ["symbol_index", "package_dir", "topics"],
      "properties": {
        "symbol_index": { "type": "string" },
        "symbol_index_lite": { "type": "string" },
        "package_dir": { "type": "string" },
        "topics": { "type": "string" }
      },
      "additionalProperties": true
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "import_path", "directory", "package_file"],
        "properties": {
          "name": { "type": "string" },
          "import_path": { "type": "string" },
          "directory": { "type": "string" },
          "doc": { "type": "string" },
          "package_file": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "specifier"],
        "properties": {
          "name": { "type": "string" },
          "specifier": { "type": "string" },
          "go_struct_name": { "type": "string" },
          "go_import_path": { "type": "string" },
          "doc": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "import_path", "package", "package_file"],
        "properties": {
          "name": { "type": "string" },
          "kind": { "type": "string" },
          "import_path": { "type": "string" },
          "package": { "type": "string" },
          "doc": { "type": "string" },
          "package_file": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
